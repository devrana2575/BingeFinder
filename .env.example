# ------------------------------------------------------------------
# BingeFinder environment configuration template.
# Copy this file to ".env" and fill in your real values.
# NEVER commit your actual .env file to version control.
# ------------------------------------------------------------------

# Runtime mode: "development" (default) or "production".
# Production enforces JWT_SECRET, hides /docs, and enables HSTS/CSP headers.
APP_ENV=development

# Required: MongoDB connection URI and database name
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=bingefinder

# Production deployment / reverse proxy tuning
# Comma-separated hostnames accepted by the API. REQUIRED when
# APP_ENV=production; replace with your real domain(s) before going live.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty for the default single-origin deployment.
# CORS_ORIGINS=https://bingefinder.example.com
# Uvicorn worker count used by the systemd unit
# (deploy/bingefinder.service.example).
# WEB_CONCURRENCY=2
# Trust X-Forwarded-* only from this reverse-proxy IP (default: 127.0.0.1).
# Set to "*" only behind a trusted proxy you control.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Directory containing the built SPA (default: frontend/dist).
# STATIC_DIR=frontend/dist

# Required for TMDb features (Free Tonight / Where to Watch / movie & TV
# catalog ingestion): a TMDb v4 READ ACCESS TOKEN. This is the preferred
# credential — the client authenticates with `Authorization: Bearer <token>`
# and does not need a v3 API key.
# Get one free at https://www.themoviedb.org/settings/api (API -> API Read
# Access Token). It is read server-side only; never commit it.
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Optional v3 API key (legacy fallback when no read-access token is set).
# TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Override TMDb API base URL (rarely needed)
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Optional: Networking / retry tuning
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
BACKOFF_FACTOR=0.5

# Optional: Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Recommendation engine
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# REBUILD_MODEL_TTL_HOURS=24

# ------------------------------------------------------------------
# Authentication & user accounts
# ------------------------------------------------------------------

# REQUIRED in production (APP_ENV=production): secret key for session tokens.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Development auto-generates a per-process secret when this is unset.
# JWT_SECRET=your_super_secret_random_string_here

# Optional: bcrypt password hashing rounds (default 12, higher = slower)
# BCRYPT_ROUNDS=12
