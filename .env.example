# ------------------------------------------------------------------
# BingeFinder environment configuration template.
# Copy this file to ".env" and fill in your real values.
# NEVER commit your actual .env file to version control.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Active backend: TVmaze + MongoDB (TMDb is currently unreachable from
# this network; the old TMDB_API_KEY/DATABASE_PATH settings below are
# kept for the legacy SQLite pipeline, which is unused but not deleted).
# ------------------------------------------------------------------

# Required: MongoDB connection URI and database name
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=bingefinder

# Optional: Override TVmaze API base URL (rarely needed)
TVMAZE_BASE_URL=https://api.tvmaze.com

# Optional: TVmaze sync tuning
# TVMAZE_SYNC_PAGES: catalog pages fetched per run (~250 shows/page).
# Default is 15 (~3,750 shows) for broad coverage. Raise further for a
# fuller catalog, e.g. TVMAZE_SYNC_PAGES=40 (~10,000 shows); the sync
# is safe to re-run at any page count — existing shows are upserted by
# tvmaze_id, never duplicated.
# TVMAZE_CAST_LIMIT: max cast members stored per show.
TVMAZE_SYNC_PAGES=15
TVMAZE_CAST_LIMIT=10

# Required: Your TMDb API key (used for "Where to Watch" provider data)
# Obtain one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Override TMDb API base URL (rarely needed)
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Optional: Networking / retry tuning
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
BACKOFF_FACTOR=0.5

# Optional: TMDb sync pagination (pages fetched per list endpoint)
# INITIAL_SYNC_PAGES is used when the database is empty (first run);
# UPDATE_SYNC_PAGES is used on subsequent runs.
INITIAL_SYNC_PAGES=20
UPDATE_SYNC_PAGES=5

# Optional: Database file location (relative or absolute path)
DATABASE_PATH=data/bingefinder.db

# Optional: Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Authentication & user accounts
# ------------------------------------------------------------------

# Optional: Secret key for session tokens (auto-generated if not set)
# Set a strong random string in production.
# JWT_SECRET=your_super_secret_random_string_here

# Optional: bcrypt password hashing rounds (default 12, higher = slower)
# BCRYPT_ROUNDS=12
